<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>RDP Manager</AssemblyTitle>
    <Product>RDP Manager</Product>
    <Version>1.1.0</Version>
    <Authors>Jiri Nalepa</Authors>
    <Company>Jiri Nalepa</Company>
    <Copyright>© 2026 Jiri Nalepa</Copyright>
    <Description>RDP connection manager with an auto-hiding screen-edge panel and KeePass support.</Description>
    <!-- Ship only our UI languages (dependencies bring satellite assemblies for many others). -->
    <SatelliteResourceLanguages>en;cs</SatelliteResourceLanguages>
    <RepositoryUrl>https://github.com/jirinalepa/RDPManager</RepositoryUrl>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- WFO0003: WinForms DPI hint; DPI awareness of this WPF app is declared in app.manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is used only for NotifyIcon and Screen; keep WPF types unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI texts: Strings.resx = English (default), Strings.cs.resx = Czech. The typed accessor
         Strings.Designer.cs is checked in (WPF's XAML pre-compilation pass cannot see build-time
         generated code) and must be public for {x:Static}; Visual Studio regenerates it on save. -->
    <EmbeddedResource Update="Properties\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="KPCLib" Version="2.0.4" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

</Project>
