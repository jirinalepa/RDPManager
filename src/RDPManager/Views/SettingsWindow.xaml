<ui:FluentWindow x:Class="RDPManager.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:RDPManager.Views"
                 xmlns:p="clr-namespace:RDPManager.Properties"
                 Title="{x:Static p:Strings.Settings_Title}"
                 Width="720" Height="600" MinWidth="600" MinHeight="480"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 ShowInTaskbar="False">
    <ui:FluentWindow.Resources>
        <views:EnumEqualsConverter x:Key="EnumEquals" />
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{x:Static p:Strings.Settings_Title}" ShowMinimize="False" ShowMaximize="False" />

        <Grid Grid.Row="1" Margin="12,4,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Section navigation -->
            <ListBox x:Name="SectionList" Grid.Column="0" Margin="0,4,12,0" Background="Transparent" BorderThickness="0"
                     SelectedIndex="0" SelectionChanged="SectionList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBoxItem><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="PanelLeft24" FontSize="18" Margin="0,0,10,0" /><TextBlock Text="{x:Static p:Strings.Settings_Nav_Dock}" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                <ListBoxItem><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Key24" FontSize="18" Margin="0,0,10,0" /><TextBlock Text="{x:Static p:Strings.Settings_Nav_KeePass}" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                <ListBoxItem><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Settings24" FontSize="18" Margin="0,0,10,0" /><TextBlock Text="{x:Static p:Strings.Settings_Nav_General}" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                <ListBoxItem><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Info24" FontSize="18" Margin="0,0,10,0" /><TextBlock Text="{x:Static p:Strings.Settings_Nav_About}" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
            </ListBox>

            <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right" Margin="0,4,0,0"
                       Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <!-- Sections -->
            <Grid x:Name="SectionHost" Grid.Column="1" Margin="12,0,0,0">
                <!-- Panel -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,0,16,16">
                        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,4,0,8" Text="{x:Static p:Strings.Settings_Nav_Dock}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static p:Strings.Settings_Edge}" />
                        <WrapPanel>
                            <RadioButton GroupName="Edge" Margin="0,0,16,0" Content="{x:Static p:Strings.Settings_Edge_Left}" IsChecked="{Binding Edge, Converter={StaticResource EnumEquals}, ConverterParameter=Left}" />
                            <RadioButton GroupName="Edge" Margin="0,0,16,0" Content="{x:Static p:Strings.Settings_Edge_Right}" IsChecked="{Binding Edge, Converter={StaticResource EnumEquals}, ConverterParameter=Right}" />
                            <RadioButton GroupName="Edge" Margin="0,0,16,0" Content="{x:Static p:Strings.Settings_Edge_Top}" IsChecked="{Binding Edge, Converter={StaticResource EnumEquals}, ConverterParameter=Top}" />
                            <RadioButton GroupName="Edge" Content="{x:Static p:Strings.Settings_Edge_Bottom}" IsChecked="{Binding Edge, Converter={StaticResource EnumEquals}, ConverterParameter=Bottom}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{x:Static p:Strings.Settings_Edge_Hint}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static p:Strings.Settings_Monitor}" />
                        <ComboBox x:Name="MonitorBox" DisplayMemberPath="Label" SelectedValuePath="DeviceName" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static p:Strings.Settings_Width}" />
                                <ui:TextBox Text="{Binding DockSize}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static p:Strings.Settings_ShowDelay}" />
                                <ui:TextBox Text="{Binding ShowDelayMs}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static p:Strings.Settings_HideDelay}" />
                                <ui:TextBox Text="{Binding HideDelayMs}" />
                            </StackPanel>
                        </Grid>

                        <ui:ToggleSwitch Margin="0,14,0,0" Content="{x:Static p:Strings.Settings_HideAfterConnect}" IsChecked="{Binding HideAfterConnect}" />
                        <ui:ToggleSwitch Margin="0,14,0,0" Content="{x:Static p:Strings.Settings_Hotkey}" IsChecked="{Binding HotkeyEnabled}" />
                        <ui:TextBox x:Name="HotkeyBox" Margin="0,8,0,0" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                    PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                    IsEnabled="{Binding HotkeyEnabled}"
                                    Icon="{ui:SymbolIcon Keyboard24}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{x:Static p:Strings.Settings_Hotkey_Hint}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- KeePass -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="4,0,16,16">
                        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,4,0,8" Text="{x:Static p:Strings.Settings_Nav_KeePass}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static p:Strings.Settings_KeePassDatabase}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Text="{Binding KeePassDatabasePath}" PlaceholderText="{x:Static p:Strings.Settings_KeePassDatabase_Placeholder}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="…" Click="BrowseDatabase_Click" />
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static p:Strings.Common_KeyFileOptional}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Text="{Binding KeePassKeyFilePath}" PlaceholderText="{x:Static p:Strings.Common_None}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="…" Click="BrowseKeyFile_Click" />
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static p:Strings.Settings_AutoLock}" />
                        <ui:TextBox Width="120" HorizontalAlignment="Left" Text="{Binding KeePassAutoLockMinutes}" />
                        <ui:ToggleSwitch Margin="0,14,0,0" Content="{x:Static p:Strings.Settings_LockOnWinL}" IsChecked="{Binding KeePassLockOnWorkstationLock}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- General -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="4,0,16,16">
                        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,4,0,8" Text="{x:Static p:Strings.Settings_Nav_General}" />
                        <ui:ToggleSwitch Content="{x:Static p:Strings.Settings_StartWithWindows}" IsChecked="{Binding StartWithWindows}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static p:Strings.Settings_Language}" />
                        <WrapPanel>
                            <RadioButton GroupName="Language" Margin="0,0,16,0" Content="{x:Static p:Strings.Common_SystemDefault}" IsChecked="{Binding Language, Converter={StaticResource EnumEquals}, ConverterParameter=System}" />
                            <RadioButton GroupName="Language" Margin="0,0,16,0" Content="English" IsChecked="{Binding Language, Converter={StaticResource EnumEquals}, ConverterParameter=English}" />
                            <RadioButton GroupName="Language" Content="Čeština" IsChecked="{Binding Language, Converter={StaticResource EnumEquals}, ConverterParameter=Czech}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static p:Strings.Settings_Theme}" />
                        <WrapPanel>
                            <RadioButton GroupName="Theme" Margin="0,0,16,0" Content="{x:Static p:Strings.Common_SystemDefault}" IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=System}" />
                            <RadioButton GroupName="Theme" Margin="0,0,16,0" Content="{x:Static p:Strings.Settings_Theme_Light}" IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Light}" />
                            <RadioButton GroupName="Theme" Content="{x:Static p:Strings.Settings_Theme_Dark}" IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Dark}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static p:Strings.Settings_CredentialCleanup}" />
                        <ui:TextBox Width="120" HorizontalAlignment="Left" Text="{Binding CredentialCleanupSeconds}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{x:Static p:Strings.Settings_CredentialCleanup_Hint}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- About -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="4,0,16,16">
                        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,4,0,8" Text="{x:Static p:Strings.Settings_Nav_About}" />
                        <Border Padding="14" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="AboutLogo" Width="40" Height="40" VerticalAlignment="Top" />
                                <StackPanel Margin="14,0,0,0">
                                    <TextBlock x:Name="AboutProduct" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="AboutCopyright" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Margin="0,6,0,0">
                                        <Hyperlink x:Name="AboutRepoLink" Click="RepoLink_Click">
                                            <Run x:Name="AboutRepoText" />
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="16,12" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Appearance="Primary" Content="{x:Static p:Strings.Common_Save}" MinWidth="100" IsDefault="True" Click="Save_Click" />
                <ui:Button Margin="8,0,0,0" Content="{x:Static p:Strings.Common_Cancel}" MinWidth="100" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
