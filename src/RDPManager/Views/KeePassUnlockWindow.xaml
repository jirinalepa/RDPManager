<ui:FluentWindow x:Class="RDPManager.Views.KeePassUnlockWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Odemknout KeePass"
                 Width="440" SizeToContent="Height" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 ShowInTaskbar="False">
    <StackPanel>
        <ui:TitleBar Title="Odemknout KeePass" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Margin="20,4,20,20">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="LockClosed24" FontSize="28" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel Margin="12,0,0,0">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="KeePass databáze" />
                    <TextBlock x:Name="DatabaseText" TextTrimming="CharacterEllipsis" MaxWidth="340"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,16,0,4" Text="Hlavní heslo" />
            <ui:PasswordBox x:Name="PasswordBox" Icon="{ui:SymbolIcon Key24}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Soubor s klíčem (volitelné)" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="KeyFileBox" PlaceholderText="(žádný)" />
                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="…" Click="BrowseKeyFile_Click" />
            </Grid>

            <TextBlock x:Name="ErrorText" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            <ui:ProgressRing x:Name="Progress" Margin="0,12,0,0" IsIndeterminate="True" Width="24" Height="24"
                             Visibility="Collapsed" />

            <StackPanel Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="OkButton" Appearance="Primary" Content="Odemknout" MinWidth="110" IsDefault="True" Click="Ok_Click" />
                <ui:Button Margin="8,0,0,0" Content="Zrušit" MinWidth="100" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
