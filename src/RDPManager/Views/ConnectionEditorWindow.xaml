<ui:FluentWindow x:Class="RDPManager.Views.ConnectionEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:RDPManager.Views"
                 Title="Spojení"
                 Width="700" Height="580" MinWidth="580" MinHeight="480"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 ShowInTaskbar="False">
    <ui:FluentWindow.Resources>
        <views:EnumEqualsConverter x:Key="EnumEquals" />
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="Spojení" ShowMinimize="False" ShowMaximize="False" />

        <Grid Grid.Row="1" Margin="12,4,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Section navigation -->
            <ListBox x:Name="SectionList" Grid.Column="0" Margin="0,4,12,0" Background="Transparent" BorderThickness="0"
                     SelectedIndex="0" SelectionChanged="SectionList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBoxItem><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Desktop24" FontSize="18" Margin="0,0,10,0" /><TextBlock Text="Obecné" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                <ListBoxItem><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Key24" FontSize="18" Margin="0,0,10,0" /><TextBlock Text="Přihlášení" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                <ListBoxItem><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Window24" FontSize="18" Margin="0,0,10,0" /><TextBlock Text="Obrazovka" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                <ListBoxItem><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowSwap24" FontSize="18" Margin="0,0,10,0" /><TextBlock Text="Přesměrování" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                <ListBoxItem><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Settings24" FontSize="18" Margin="0,0,10,0" /><TextBlock Text="Pokročilé" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
            </ListBox>

            <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right" Margin="0,4,0,0"
                       Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <!-- Sections -->
            <Grid x:Name="SectionHost" Grid.Column="1" Margin="12,0,0,0">            <!-- General -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,4,12,12">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Název" />
                        <ui:TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="např. Souborový server" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Adresa (hostname nebo IP)" />
                                <ui:TextBox x:Name="HostBox" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="server.firma.local" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Port" />
                                <ui:TextBox Text="{Binding Port}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Skupina" />
                        <ComboBox x:Name="GroupBox" IsEditable="True" Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Poznámka" />
                        <ui:TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" VerticalContentAlignment="Top" />
                    </StackPanel>
                </ScrollViewer>

            <!-- Credentials -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="4,4,12,12">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Způsob přihlášení" />
                        <RadioButton GroupName="Mode" Content="Doménový / aktuální účet (mstsc použije uložené údaje nebo se zeptá)"
                                     IsChecked="{Binding CredentialMode, Converter={StaticResource EnumEquals}, ConverterParameter=Default}" />
                        <RadioButton GroupName="Mode" Margin="0,6,0,0" Content="Jen přednastavené uživatelské jméno"
                                     IsChecked="{Binding CredentialMode, Converter={StaticResource EnumEquals}, ConverterParameter=Username}" />
                        <RadioButton GroupName="Mode" Margin="0,6,0,0" Content="Jméno a heslo z KeePassu"
                                     IsChecked="{Binding CredentialMode, Converter={StaticResource EnumEquals}, ConverterParameter=KeePass}" />

                        <StackPanel x:Name="KeePassPanel" Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Záznam v KeePassu" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox IsReadOnly="True" Text="{Binding KeePassEntryTitle, Mode=OneWay}"
                                            PlaceholderText="(nevybráno)" Icon="{ui:SymbolIcon Key24}" />
                                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Vybrat…" Click="PickEntry_Click" />
                            </Grid>
                        </StackPanel>

                        <TextBlock x:Name="UsernameLabel" Style="{StaticResource FieldLabel}" Text="Uživatelské jméno" />
                        <ui:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="DOMENA\uzivatel nebo uzivatel@domena" />
                        <TextBlock x:Name="UsernameHint" Style="{StaticResource Hint}" />
                    </StackPanel>
                </ScrollViewer>

            <!-- Display -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="4,4,12,12">
                        <ui:ToggleSwitch Margin="0,12,0,0" Content="Celá obrazovka" IsChecked="{Binding FullScreen}" />
                        <ui:ToggleSwitch Margin="0,12,0,0" Content="Použít více monitorů" IsChecked="{Binding UseMultimon}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Vybrané monitory (volitelné)" />
                        <ui:TextBox Text="{Binding SelectedMonitors}" PlaceholderText="např. 0,1" />
                        <TextBlock Style="{StaticResource Hint}" Text="ID monitorů zobrazí příkaz „mstsc /l“. Prázdné = všechny." />
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Velikost okna (když není celá obrazovka)" />
                        <StackPanel Orientation="Horizontal">
                            <ui:TextBox Width="110" Text="{Binding Width}" />
                            <TextBlock Margin="8,0" VerticalAlignment="Center" Text="×" />
                            <ui:TextBox Width="110" Text="{Binding Height}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

            <!-- Redirection -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="4,4,12,12">
                        <ui:ToggleSwitch Margin="0,12,0,0" Content="Schránka" IsChecked="{Binding RedirectClipboard}" />
                        <ui:ToggleSwitch Margin="0,12,0,0" Content="Lokální disky" IsChecked="{Binding RedirectDrives}" />
                        <ui:ToggleSwitch Margin="0,12,0,0" Content="Tiskárny" IsChecked="{Binding RedirectPrinters}" />
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Zvuk" />
                        <RadioButton GroupName="Audio" Content="Přehrávat na tomto počítači"
                                     IsChecked="{Binding AudioMode, Converter={StaticResource EnumEquals}, ConverterParameter=Local}" />
                        <RadioButton GroupName="Audio" Margin="0,6,0,0" Content="Přehrávat na vzdáleném počítači"
                                     IsChecked="{Binding AudioMode, Converter={StaticResource EnumEquals}, ConverterParameter=Remote}" />
                        <RadioButton GroupName="Audio" Margin="0,6,0,0" Content="Nepřehrávat"
                                     IsChecked="{Binding AudioMode, Converter={StaticResource EnumEquals}, ConverterParameter=None}" />
                    </StackPanel>
                </ScrollViewer>

            <!-- Advanced -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="4,4,12,12">
                        <ui:ToggleSwitch Margin="0,12,0,0" Content="Administrátorská relace (/admin)" IsChecked="{Binding AdminSession}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="RD Gateway (volitelné)" />
                        <ui:TextBox Text="{Binding GatewayHost}" PlaceholderText="gateway.firma.cz" />
                        <TextBlock Style="{StaticResource Hint}" Text="Při přihlášení z KeePassu se stejné údaje použijí i pro gateway." />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Další nastavení .rdp (přepíší vygenerovaná)" />
                        <ui:TextBox Text="{Binding ExtraRdpSettings}" AcceptsReturn="True" TextWrapping="NoWrap"
                                    MinHeight="120" VerticalContentAlignment="Top" FontFamily="Cascadia Mono, Consolas"
                                    PlaceholderText="např. smart sizing:i:1" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="16,12"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Appearance="Primary" Content="Uložit" MinWidth="100" IsDefault="True" Click="Save_Click" />
                <ui:Button Margin="8,0,0,0" Content="Zrušit" MinWidth="100" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
