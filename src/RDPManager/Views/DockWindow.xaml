<Window x:Class="RDPManager.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:m="clr-namespace:RDPManager.Models"
        xmlns:views="clr-namespace:RDPManager.Views"
        xmlns:p="clr-namespace:RDPManager.Properties"
        Title="RDP Manager"
        Width="300" Height="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <Window.Resources>
        <views:EmptyGroupConverter x:Key="EmptyGroupConverter" />
        <views:CredentialIconConverter x:Key="CredentialIconConverter" />
        <views:EmptyToNullConverter x:Key="EmptyToNullConverter" />

        <ContextMenu x:Key="ConnectionMenu" x:Shared="False">
            <MenuItem Header="{x:Static p:Strings.Dock_Menu_Connect}" Click="Connect_Click" Icon="{ui:SymbolIcon Play24}" FontWeight="SemiBold" />
            <MenuItem Header="{x:Static p:Strings.Dock_Menu_ConnectAdmin}" Click="ConnectAdmin_Click" Icon="{ui:SymbolIcon Shield24}" />
            <Separator />
            <MenuItem Header="{x:Static p:Strings.Dock_Menu_Edit}" Click="Edit_Click" Icon="{ui:SymbolIcon Edit24}" />
            <MenuItem Header="{x:Static p:Strings.Dock_Menu_Duplicate}" Click="Duplicate_Click" Icon="{ui:SymbolIcon Copy24}" />
            <MenuItem Header="{x:Static p:Strings.Dock_Menu_CopyAddress}" Click="CopyHost_Click" Icon="{ui:SymbolIcon Desktop24}" />
            <Separator />
            <MenuItem Header="{x:Static p:Strings.Common_Delete}" Click="Delete_Click" Icon="{ui:SymbolIcon Delete24}" />
        </ContextMenu>

        <Style x:Key="ConnectionItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="ContextMenu" Value="{StaticResource ConnectionMenu}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <EventSetter Event="MouseDoubleClick" Handler="Item_DoubleClick" />
        </Style>
    </Window.Resources>

    <Border x:Name="Panel"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0"
            CornerRadius="0,10,10,0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" />
        </Border.RenderTransform>

        <Grid Margin="12,12,12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="2,0,0,10" LastChildFill="False">
                <Image x:Name="LogoImage" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="RDP Manager" />
                <ToggleButton DockPanel.Dock="Right" Padding="6" ToolTip="{x:Static p:Strings.Dock_Pin_Tooltip}"
                              IsChecked="{Binding IsPinned}" Checked="Pin_Changed" Unchecked="Pin_Changed">
                    <ui:SymbolIcon Symbol="Pin20" />
                </ToggleButton>
            </DockPanel>

            <!-- Search -->
            <ui:TextBox x:Name="SearchBox" Grid.Row="1"
                        PlaceholderText="{x:Static p:Strings.Dock_Search_Placeholder}"
                        Icon="{ui:SymbolIcon Search20}"
                        ClearButtonEnabled="True"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        PreviewKeyDown="SearchBox_PreviewKeyDown" />

            <!-- Connections -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <ListBox x:Name="ConnectionList"
                         ItemsSource="{Binding ConnectionsView}"
                         ItemContainerStyle="{StaticResource ConnectionItemStyle}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         KeyDown="ConnectionList_KeyDown">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <Expander IsExpanded="True" Margin="0,0,0,4" Padding="0"
                                                          Background="Transparent" BorderThickness="0">
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Folder24" FontSize="14" Margin="0,0,6,0"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name, Converter={StaticResource EmptyGroupConverter}}" />
                                                            <TextBlock Margin="6,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                       Text="{Binding ItemCount}" />
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <ItemsPresenter />
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:Connection}">
                            <Grid ToolTip="{Binding Notes, Converter={StaticResource EmptyToNullConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Desktop24" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DisplayAddress}" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ui:SymbolIcon Grid.Column="2" FontSize="14" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Symbol="{Binding CredentialMode, Converter={StaticResource CredentialIconConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel VerticalAlignment="Center" Margin="12"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <ui:SymbolIcon Symbol="DesktopArrowRight24" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{x:Static p:Strings.Dock_Empty}" />
                </StackPanel>
            </Grid>

            <!-- Active sessions -->
            <StackPanel Grid.Row="3" Margin="0,8,0,0"
                        Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Margin="2,0,0,6" FontSize="12" FontWeight="SemiBold" Text="{x:Static p:Strings.Dock_ActiveSessions}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6" Cursor="Hand"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    MouseLeftButtonUp="Session_Click" ToolTip="{x:Static p:Strings.Dock_Session_Tooltip}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Fill="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Connection.Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding StartedAtText}" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="2" Padding="4" Appearance="Transparent" ToolTip="{x:Static p:Strings.Dock_Disconnect_Tooltip}"
                                               Icon="{ui:SymbolIcon Dismiss16}" Click="SessionClose_Click" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Toolbar -->
            <Grid Grid.Row="4" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Add20}" Content="{x:Static p:Strings.Dock_New}" Click="Add_Click" ToolTip="{x:Static p:Strings.Dock_New_Tooltip}" />
                    <ui:Button Margin="6,0,0,0" Padding="8" Appearance="Transparent" Icon="{ui:SymbolIcon ArrowImport20}"
                               Click="Import_Click" ToolTip="{x:Static p:Strings.Import_Title}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Padding="8" Appearance="Transparent" Icon="{ui:SymbolIcon LockClosed20}"
                               Click="LockKeePass_Click" ToolTip="{x:Static p:Strings.Dock_LockKeePass_Tooltip}"
                               Visibility="{Binding IsKeePassOpen, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Padding="8" Appearance="Transparent" Icon="{ui:SymbolIcon Settings20}"
                               Click="Settings_Click" ToolTip="{x:Static p:Strings.Dock_Settings_Tooltip}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
